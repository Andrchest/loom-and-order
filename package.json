{
  "name": "loom-and-order",
  "version": "0.1.0",
  "private": true,
  "description": "Loom & Order — a durable local multi-agent runtime for Pi with initiatives, epics, tasks, reviewers, worktrees, and MCP control.",
  "type": "module",
  "bin": {
    "lao": "./src/cli.ts"
  },
  "files": [
    "README.md",
    "docs",
    "profiles",
    "scripts",
    "skills",
    "src"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "mlflow-tracing": "^0.1.3"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/cli.ts",
    "mcp": "node --experimental-strip-types src/cli.ts mcp",
    "test": "LAO_MLFLOW_ENABLED=0 LAO_SQLITE_SYNC=normal LAO_TOOLCHAIN_AUTO_UPDATE=0 node --experimental-strip-types --test test/*.test.ts",
    "check": "node --experimental-strip-types src/cli.ts --help",
    "gate": "npm test && npm run check"
  }
}
